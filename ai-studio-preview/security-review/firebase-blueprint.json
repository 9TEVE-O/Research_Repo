{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Researcher user profile metadata isolated to the authenticated owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the researcher.",
          "minLength": 1,
          "maxLength": 100
        },
        "activeTabPreference": {
          "type": "string",
          "description": "Last active module tab.",
          "enum": ["terminal", "discovery", "knowledge-graph", "typesafe", "reports", "guardrails"],
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": ["ownerId", "displayName", "activeTabPreference", "createdAt", "updatedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved academic paper or scored repository item bookmarked by a researcher.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the user who created the bookmark.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemId": {
          "type": "string",
          "description": "Identifier of the bookmarked paper or repository.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "description": "Type of bookmarked resource.",
          "enum": ["paper", "repository"],
          "minLength": 1,
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "description": "Title of the paper or repository full name.",
          "minLength": 1,
          "maxLength": 300
        },
        "sourceOrLanguage": {
          "type": "string",
          "description": "Publication venue or programming language.",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "description": "External link to the paper or GitHub repository.",
          "minLength": 1,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "description": "Optional user research annotation.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when bookmarked."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": ["ownerId", "itemId", "itemType", "title", "sourceOrLanguage", "url", "notes", "createdAt", "updatedAt"]
    },
    "CustomPaper": {
      "title": "CustomPaper",
      "description": "User-synthesized or custom added academic paper entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the researcher who added the paper.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topic": {
          "type": "string",
          "description": "Domain topic identifier.",
          "minLength": 1,
          "maxLength": 50
        },
        "topicLabel": {
          "type": "string",
          "description": "Human-readable domain topic label.",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "description": "Full publication title.",
          "minLength": 1,
          "maxLength": 300
        },
        "authors": {
          "type": "string",
          "description": "Comma-separated author names.",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "description": "Publication source (e.g., arXiv, MIT, IEEE).",
          "minLength": 1,
          "maxLength": 60
        },
        "date": {
          "type": "string",
          "description": "Publication date string.",
          "minLength": 1,
          "maxLength": 40
        },
        "abstract": {
          "type": "string",
          "description": "Paper abstract summary.",
          "minLength": 1,
          "maxLength": 1000
        },
        "url": {
          "type": "string",
          "description": "Direct link to publication.",
          "minLength": 1,
          "maxLength": 500
        },
        "doi": {
          "type": "string",
          "description": "Digital Object Identifier.",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerId", "topic", "topicLabel", "title", "authors", "source", "date", "abstract", "url", "doi", "createdAt"]
    },
    "CustomRepo": {
      "title": "CustomRepo",
      "description": "User-submitted GitHub repository evaluated by the scoring pipeline.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the researcher who scored the repository.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Short repository name.",
          "minLength": 1,
          "maxLength": 100
        },
        "full_name": {
          "type": "string",
          "description": "Owner/repository full name.",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "description": "GitHub repository URL.",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "description": "Repository description.",
          "minLength": 1,
          "maxLength": 500
        },
        "relevance_score": {
          "type": "integer",
          "description": "0-100 relevance score."
        },
        "summary": {
          "type": "string",
          "description": "Executive summary.",
          "minLength": 1,
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "description": "Scoring rationale.",
          "minLength": 1,
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "description": "Primary language.",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerId", "name", "full_name", "url", "description", "relevance_score", "summary", "reason", "language", "createdAt"]
    },
    "SearchHistory": {
      "title": "SearchHistory",
      "description": "Recorded global search query with active tab context.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the user who executed the search.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "query": {
          "type": "string",
          "description": "Search query string.",
          "minLength": 1,
          "maxLength": 200
        },
        "contextTab": {
          "type": "string",
          "description": "Active tab context when the search was executed.",
          "enum": ["terminal", "discovery", "knowledge-graph", "typesafe", "reports", "guardrails"],
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of search execution."
        }
      },
      "required": ["ownerId", "query", "contextTab", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Per-user profile preferences and metadata."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User-saved paper and repository bookmarks."
    },
    "/customPapers/{paperId}": {
      "schema": "CustomPaper",
      "description": "User-injected academic papers persisted across sessions."
    },
    "/customRepos/{repoId}": {
      "schema": "CustomRepo",
      "description": "User-evaluated GitHub repositories persisted across sessions."
    },
    "/searchHistory/{searchId}": {
      "schema": "SearchHistory",
      "description": "User global search queries with active tab context."
    }
  }
}
