{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WikiNote",
  "description": "AI-generated wiki page (entity, summary, or contradiction). All fields are required by Rule 2.",
  "type": "object",
  "required": ["id", "type", "content_markdown", "generated_by", "generated_at", "source_ids", "confidence"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "enum": ["entity", "claim", "contradiction", "summary"] },
    "content_markdown": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "description": "Agent or model identifier (Rule 2)" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Must cite at least one source for claim pages (Rule 3)"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_reviewed": { "type": "boolean", "default": false },
    "tags": {
      "type": "array",
      "items": { "type": "string", "enum": ["fact", "inference", "strategy", "unverified"] },
      "description": "Rule 4: separate fact / inference / strategy / unverified"
    },
    "last_updated": { "type": "string", "format": "date-time" }
  }
}
