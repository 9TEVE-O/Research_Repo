{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaimNote",
  "description": "An evidence-backed claim. Evidence is required — Rule 3.",
  "type": "object",
  "required": ["id", "type", "claim_text", "evidence", "status", "content_markdown", "generated_by", "generated_at", "source_ids", "confidence"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "claim" },
    "claim_text": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id"],
        "properties": {
          "source_id": { "type": "string" },
          "quote": { "type": "string" },
          "location": { "type": "string" }
        }
      }
    },
    "status": { "type": "string", "enum": ["proposed", "verified", "contested", "deprecated"] },
    "content_markdown": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_reviewed": { "type": "boolean", "default": false },
    "tags": { "type": "array", "items": { "type": "string" } },
    "last_updated": { "type": "string", "format": "date-time" }
  }
}
