{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source",
  "description": "Immutable raw source record. Never modified after ingestion (Rule 1).",
  "type": "object",
  "required": ["source_id", "hash", "ingested_at", "original_path"],
  "additionalProperties": false,
  "properties": {
    "source_id": { "type": "string", "pattern": "^src_[a-f0-9]{12}$" },
    "hash": { "type": "string", "description": "SHA-256 of raw content" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "original_path": { "type": "string" },
    "mime_type": { "type": "string", "default": "text/plain" },
    "source_url": { "type": "string", "default": "" },
    "immutable": { "type": "boolean", "const": true }
  }
}
